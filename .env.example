# Admin bootstrap credentials. Used to create the first admin in data/admin.json
# on first login. Change the password from Admin > Settings afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin session + participant cookies. Use 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Where JSON database files and uploads are stored (must be persistent in production).
DATA_DIR=./data

# Public URL shown in admin settings / share messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel / serverless hosting -------------------------------------------
# Vercel has no shared, persistent disk, so DATA_DIR is not used there. Instead:
#  * Database: connect an Upstash Redis store (Vercel > Storage). It sets
#    KV_REST_API_URL + KV_REST_API_TOKEN automatically. UPSTASH_REDIS_REST_URL /
#    UPSTASH_REDIS_REST_TOKEN also work. When set, the app uses Redis instead of JSON files.
#  * Uploads: connect a Vercel Blob store. It sets BLOB_READ_WRITE_TOKEN automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
